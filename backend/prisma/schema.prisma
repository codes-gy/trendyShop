generator client {
  provider = "prisma-client-py"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING // 결제 대기
  PAID // 결제 완료 (상품 준비중)
  SHIPPED // 배송 중
  DELIVERED // 배송 완료
  CANCELLED // 주문 취소
}

enum PaymentMethod {
  CARD
  TRANSFER
  VIRTUAL_ACCOUNT
  POINT
}

enum DeliveryStatus {
  PREPARING // 배송 준비중
  DISPATCHED // 배송 시작 (택배사 인계)
  IN_TRANSIT // 배송 중
  DELIVERED // 배송 완료
}

enum Provider {
  LOCAL
  KAKAO
  GOOGLE
  NAVER
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String? // 암호화된 비밀번호
  name       String
  role       Role     @default(USER) // USER(일반회원), ADMIN(관리자)
  provider   Provider @default(LOCAL) // "LOCAL", "KAKAO", "GOOGLE", "NAVER" 등
  providerId String? // 소셜사에서 제공하는 고유 회원 번호 (UID)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // 관계 설정
  orders    Order[]
  cartItems CartItem[]
  reviews   Review[] // 유저가 작성한 리뷰 목록 (1:N)

  @@index([provider, providerId])
}

// 2. 상품 모델
model Product {
  id          Int            @id @default(autoincrement())
  name        String
  description String?        @db.Text
  price       Int // 상품 기본 가격
  stock       Int // 현재 재고 수량
  isAvailable Boolean        @default(true) // 판매 가능 여부
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  // 관계 설정
  images      ProductImage[] // 상품 이미지 다중화 (1:N)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[] // 상품에 달린 리뷰 목록 (1:N)

  @@index([isAvailable, deletedAt])
}

// 3. 상품 이미지 다중화 모델
model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  imageUrl  String // S3나 스토리지에 업로드된 URL 경로
  isMain    Boolean  @default(false) // 대표 썸네일 여부
  createdAt DateTime @default(now())

  // 관계 설정
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// 4. 장바구니 상품 모델
model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int // 장바구니에 담은 수량
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 관계 설정
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// 5. 주문 마스터 정보 모델
model Order {
  id         Int         @id @default(autoincrement())
  userId     Int
  totalPrice Int // 총 주문/결제 금액
  status     OrderStatus @default(PENDING) // 주문 상태 정보
  address    String // 배송지 기본 주소
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // 관계 설정
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  payment    Payment? // 주문 한 개당 결제 정보는 한 개 존재 (1:1)
  deliveries  Delivery[] // 주문 한 개당 배송 정보는 여러 개

  @@index([userId, createdAt(sort: Desc)])
}

// 6. 주문 상세 항목 모델
model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  productId  Int
  deliveryId Int?
  price      Int // 주문을 마친 시점의 실결제 단가 (과거 이력 보존용)
  quantity   Int // 주문 수량
  totalPrice Int
  createdAt  DateTime @default(now())

  // 관계 설정
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict) // 주문된 상품은 임의 삭제 방지
  delivery Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([deliveryId])
}

// 7. 결제 정보 모델
model Payment {
  id         Int           @id @default(autoincrement())
  orderId    Int           @unique // 1:1 관계를 위한 유니크 조건
  paymentKey String? // 외부 PG사 거래 고유 키
  method     PaymentMethod @default(CARD) // 결제 수단
  amount     Int // 실제 결제 승인 금액
  paidAt     DateTime? // 실제 결제 완료 일시
  createdAt  DateTime      @default(now())

  // 관계 설정
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// 8. 배송 정보 모델
model Delivery {
  id             Int            @id @default(autoincrement())
  orderId        Int
  trackingNumber String? // 운송장 번호
  carrier        String? // 택배 회사명 (예: CJ대한통운, 한진택배)
  status         DeliveryStatus @default(PREPARING) // 배송 구체적 상태
  recipientName  String // 수령인 이름
  recipientPhone String // 수령인 연락처
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // 관계 설정
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([orderId])
}

// 상품 리뷰
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  rating    Int // 별점
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 관계 설정
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade) // 유저 탈퇴 시 리뷰도 삭제
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade) // 상품 삭제 시 리뷰도 삭제

  @@unique([userId, productId])
  @@index([productId, createdAt(sort: Desc)])
}
