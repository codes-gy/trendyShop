# 로컬 개발용 예시입니다. `cp .env.example .env` 후 값을 채우세요. (.env는 커밋하지 않습니다)
DATABASE_URL=postgresql://trendy_user:postgres@localhost:5432/trendy_commerce

JWT_ALGORITHM=HS256
# 각각 충분히 긴 임의 문자열로 직접 생성하세요. (예: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_COOKIE_NAME=accessToken
REFRESH_TOKEN_COOKIE_NAME=refreshToken
# 초 단위 숫자 또는 s/m/h/d 접미사 (예: 900, 15m, 1h, 7d)
JWT_ACCESS_TOKEN_EXPIRES=1h
JWT_REFRESH_TOKEN_EXPIRES=7d

ORDER_PENDING_EXPIRATION_MINUTES=30

# toss: 토스페이먼츠 결제 승인 API 호출 / fake: 로컬 개발용 가짜 승인 (운영 환경에서 절대 사용 금지)
PAYMENT_GATEWAY=toss
TOSS_PAYMENTS_SECRET_KEY=
